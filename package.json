{
  "name": "methodpilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --experimental-strip-types server/index.ts",
    "server:showcase": "AI_PROVIDER=showcase node --experimental-strip-types server/index.ts",
    "server:cli": "AI_PROVIDER=cli node --experimental-strip-types server/index.ts",
    "server:http": "AI_PROVIDER=http node --experimental-strip-types server/index.ts",
    "parser:test": "python3 server/pdf/parser.py --selftest",
    "relevance:test": "node --experimental-strip-types scripts/relevance-test.mjs",
    "citation:test": "node --experimental-strip-types scripts/citation-paths-test.mjs",
    "batch:test": "node --experimental-strip-types scripts/batch-add-test.mjs",
    "fulltext:test": "node --experimental-strip-types scripts/fulltext-test.mjs",
    "analyze:test": "node --experimental-strip-types scripts/analyze-chain-test.mjs",
    "batch-analyze:test": "node --experimental-strip-types scripts/batch-analyze-test.mjs",
    "method-align:test": "node --experimental-strip-types scripts/method-align-test.mjs",
    "method-align:replay": "node --experimental-strip-types scripts/method-align-replay-demo.mjs",
    "method-align:api-test": "node --experimental-strip-types scripts/method-align-api-test.mjs",
    "method-align:ui-test": "node --experimental-strip-types scripts/method-align-ui-test.mjs",
    "evolution:test": "node --experimental-strip-types scripts/evolution-test.mjs",
    "evolution:api-test": "node --experimental-strip-types scripts/evolution-api-test.mjs",
    "evolution:ui-test": "node --experimental-strip-types scripts/evolution-ui-test.mjs",
    "gap:test": "node --experimental-strip-types scripts/gap-test.mjs",
    "gap:sanity": "node --experimental-strip-types scripts/gap-sanity.mjs",
    "direction:test": "node --experimental-strip-types scripts/direction-test.mjs",
    "gap:api-test": "node --experimental-strip-types scripts/gap-api-test.mjs",
    "gap:ui-test": "node --experimental-strip-types scripts/gap-ui-test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "uitest": "node scripts/uitest.mjs",
    "verify": "node scripts/e2e.mjs && node scripts/uitest.mjs",
    "verify-live": "node scripts/verify-live-data.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "direction:api-test": "node --experimental-strip-types scripts/direction-api-test.mjs",
    "stats:ui-test": "node --experimental-strip-types scripts/project-stats-ui-test.mjs",
    "report:test": "node --experimental-strip-types scripts/report-test.mjs",
    "report:ui-test": "node --experimental-strip-types scripts/report-ui-test.mjs",
    "accept:test": "node --experimental-strip-types scripts/acceptance-test.mjs",
    "phase7:demo": "node --experimental-strip-types scripts/phase7-demo-walkthrough.mjs",
    "phase6-2:test": "node --experimental-strip-types scripts/phase6-2-causal-e2e.mjs",
    "phase6-2:ui-test": "node scripts/phase6-2-causal-ui-verify.mjs",
    "store:concurrency-test": "node --experimental-strip-types scripts/store-concurrency-test.mjs",
    "store:consistency-test": "node --experimental-strip-types scripts/store-consistency-test.mjs",
    "phase6-2:concurrent-test": "node scripts/phase6-2-concurrent-upload-test.mjs",
    "showcase:e2e": "node --experimental-strip-types scripts/showcase-e2e.mjs",
    "demo:reset": "node scripts/demo-reset.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
